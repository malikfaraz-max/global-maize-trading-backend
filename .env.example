# Copy this file to .env and fill in real values. Never commit the real .env file.

# Any long random string — used to sign admin login sessions.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of sites allowed to submit quotes to this API.
ALLOWED_ORIGINS=https://globalmaizetrading.com,https://YOUR_GITHUB_USERNAME.github.io

# Port the server listens on (most hosts set this automatically).
PORT=4000

# Chad conversational AI (keep this secret; never put it in frontend files)
OPENAI_API_KEY=
CHAD_MODEL=gpt-5.6-luna
